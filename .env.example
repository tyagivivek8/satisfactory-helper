# Optional overrides. Defaults auto-detect the standard Steam/Epic locations.
SATISFACTORY_SAVES=C:\Users\you\AppData\Local\FactoryGame\Saved\SaveGames
SATISFACTORY_DOCS=C:\Program Files (x86)\Steam\steamapps\common\Satisfactory\CommunityResources\Docs\en-US.json
# Needed only when the installation is outside the standard Steam/Epic locations.
# SATISFACTORY_GAME_ROOT=D:\SteamLibrary\steamapps\common\Satisfactory
SATISFACTORY_HELPER_PORT=8713
# SATISFACTORY_HELPER_POLL_SECONDS=2
# Leave unset to let Codex select its current subscription default automatically.
# SATISFACTORY_HELPER_CODEX_MODEL=
# SATISFACTORY_HELPER_CLAUDE_MODEL=
