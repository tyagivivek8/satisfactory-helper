{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "headline",
    "summary",
    "overall_status",
    "capacity_basis",
    "factory_strategy",
    "save_token",
    "target",
    "metrics",
    "evidence",
    "assumptions",
    "blockers",
    "raw_inputs",
    "actions",
    "floors",
    "unlock_advice",
    "follow_up"
  ],
  "properties": {
    "headline": {"type": "string"},
    "summary": {"type": "string"},
    "overall_status": {"enum": ["verified", "needs_confirmation", "blocked"]},
    "capacity_basis": {"type": "string", "const": "nameplate"},
    "factory_strategy": {"enum": ["same_factory", "new_factory"]},
    "save_token": {"type": "string"},
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["item", "rate_per_min", "site", "factory", "floor"],
      "properties": {
        "item": {"type": ["string", "null"]},
        "rate_per_min": {"type": ["number", "null"]},
        "site": {"type": ["string", "null"]},
        "factory": {"type": ["string", "null"]},
        "floor": {"type": ["integer", "null"]}
      }
    },
    "metrics": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["label", "value", "unit", "status"],
        "properties": {
          "label": {"type": "string"},
          "value": {"anyOf": [{"type": "number"}, {"type": "string"}]},
          "unit": {"type": ["string", "null"]},
          "status": {"enum": ["verified", "needs_confirmation", "blocked"]}
        }
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["claim", "status", "source", "detail"],
        "properties": {
          "claim": {"type": "string"},
          "status": {"enum": ["verified", "needs_confirmation", "blocked"]},
          "source": {"type": "string"},
          "detail": {"type": "string"}
        }
      }
    },
    "assumptions": {"type": "array", "items": {"type": "string"}},
    "blockers": {"type": "array", "items": {"type": "string"}},
    "raw_inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["item", "rate_per_min", "strategy", "effect", "sources"],
        "properties": {
          "item": {"type": "string"},
          "rate_per_min": {"type": "number", "minimum": 0},
          "strategy": {
            "enum": [
              "player_supplied",
              "nameplate_spare",
              "overclock",
              "rebalanced_output",
              "new_extractor"
            ]
          },
          "effect": {
            "type": "string",
            "description": "Exact capacity equation or before/after output tradeoff that makes this raw supply valid."
          },
          "sources": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "node_id",
                "distance_m",
                "rate_per_min",
                "saved_clock_percent",
                "final_clock_percent",
                "power_shards",
                "transport_mode"
              ],
              "properties": {
                "node_id": {"type": "string"},
                "distance_m": {"type": "number", "minimum": 0},
                "rate_per_min": {"type": "number", "minimum": 0},
                "saved_clock_percent": {"type": "number", "minimum": 0},
                "final_clock_percent": {"type": "number", "minimum": 0, "maximum": 250},
                "power_shards": {"type": "integer", "minimum": 0, "maximum": 3},
                "transport_mode": {
                  "enum": ["belt", "pipe", "vehicle", "train", "drone"]
                }
              }
            }
          }
        }
      }
    },
    "actions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "status",
          "title",
          "why",
          "quantity",
          "building",
          "recipe",
          "rate_per_min",
          "from_floor",
          "to_floor",
          "site",
          "coordinates",
          "connections",
          "transfer_item",
          "source_site",
          "destination_site",
          "transfer_purpose",
          "authorization_quote",
          "source_distance_m",
          "transport_mode"
        ],
        "properties": {
          "id": {"type": "string"},
          "kind": {
            "enum": [
              "add",
              "remove",
              "move",
              "reroute",
              "set_recipe",
              "change_clock",
              "keep",
              "manual_check"
            ]
          },
          "status": {"enum": ["verified", "needs_confirmation", "blocked"]},
          "title": {"type": "string"},
          "why": {"type": "string"},
          "quantity": {"type": ["number", "null"]},
          "building": {"type": ["string", "null"]},
          "recipe": {"type": ["string", "null"]},
          "rate_per_min": {"type": ["number", "null"]},
          "from_floor": {"type": ["integer", "null"]},
          "to_floor": {"type": ["integer", "null"]},
          "site": {"type": ["string", "null"]},
          "coordinates": {
            "type": ["object", "null"],
            "additionalProperties": false,
            "required": ["x_m", "y_m", "z_m"],
            "properties": {
              "x_m": {"type": "number"},
              "y_m": {"type": "number"},
              "z_m": {"type": ["number", "null"]}
            }
          },
          "connections": {"type": "array", "items": {"type": "string"}},
          "transfer_item": {
            "type": ["string", "null"],
            "description": "Material carried by a reroute action; null for non-material actions."
          },
          "source_site": {
            "type": ["string", "null"],
            "description": "Physical source factory or raw node for a reroute action."
          },
          "destination_site": {
            "type": ["string", "null"],
            "description": "Physical destination factory, storage, or sink for a reroute action."
          },
          "transfer_purpose": {
            "enum": ["none", "internal", "raw_input", "storage", "production_input"]
          },
          "authorization_quote": {
            "type": ["string", "null"],
            "description": "Exact player words authorizing a cross-factory production input; otherwise null."
          },
          "source_distance_m": {
            "type": ["number", "null"],
            "minimum": 0,
            "description": "Verified straight-line distance from a raw source to its destination; null when no raw route exists."
          },
          "transport_mode": {
            "enum": ["none", "belt", "pipe", "vehicle", "train", "drone"]
          }
        }
      }
    },
    "floors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["floor", "label", "status", "instructions"],
        "properties": {
          "floor": {"type": ["integer", "null"]},
          "label": {"type": "string"},
          "status": {"enum": ["verified", "needs_confirmation", "blocked"]},
          "instructions": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "unlock_advice": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "kind", "priority", "reason", "used_by_current_plan"],
        "properties": {
          "name": {"type": "string"},
          "kind": {"enum": ["hard_drive", "milestone", "mam", "none"]},
          "priority": {"enum": ["now", "soon", "later", "skip"]},
          "reason": {"type": "string"},
          "used_by_current_plan": {"type": "boolean"}
        }
      }
    },
    "follow_up": {"type": ["string", "null"]}
  }
}
